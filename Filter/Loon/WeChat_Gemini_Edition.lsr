# WeChat Gemini Edition - Optimized for Overseas Accounts
# Last Updated: 2026-11-25
# Excludes shared QQ/Tencent Video domains (qq.com, gtimg.com, qpic.cn, qlogo.cn)
# to avoid affecting Mainland QQ & Tencent Video.

#[Rule]
# =======================================================
# I. Core & Exclusive WeChat Domains
# =======================================================
DOMAIN,apd-pcdnwxlogin.teg.tencent-cloud.net
DOMAIN,slife.xy-asia.com
DOMAIN-SUFFIX,wechat.com
DOMAIN-SUFFIX,wechatlegal.net
DOMAIN-SUFFIX,wechatos.net
DOMAIN-SUFFIX,wechatopen.com
DOMAIN-SUFFIX,wechatpay.com
DOMAIN-SUFFIX,wechatpay.cn
DOMAIN-SUFFIX,weixin.qq.com
DOMAIN-SUFFIX,weixin.com
DOMAIN-SUFFIX,servicewechat.com
DOMAIN-SUFFIX,weixinbridge.com
DOMAIN-SUFFIX,weixinsxy.com
DOMAIN-SUFFIX,iot-tencent.com
DOMAIN-SUFFIX,tenpay.com

# =======================================================
# II. Tencent Cloud Overseas IP Segments
# Intercepts WeChat MMTLS / HTTPDNS direct-IP connections
# without touching Mainland Tencent IPs.
# =======================================================
IP-CIDR,43.128.0.0/11,no-resolve
IP-CIDR,43.160.0.0/14,no-resolve
IP-CIDR,49.51.0.0/16,no-resolve
IP-CIDR,101.32.0.0/16,no-resolve
IP-CIDR,101.33.0.0/16,no-resolve
IP-CIDR,119.28.0.0/16,no-resolve
IP-CIDR,129.226.0.0/16,no-resolve
IP-CIDR,150.109.0.0/16,no-resolve
IP-CIDR,162.14.0.0/16,no-resolve
IP-CIDR,203.205.0.0/16,no-resolve
